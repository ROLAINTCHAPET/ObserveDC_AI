# Copier en .env (jamais versionné). Secrets : variables d'environnement ou Vault (SAD §4.4).

# Comptes PostgreSQL par rôle
OWNER_DB_PASSWORD=
INGEST_DB_PASSWORD=
MCP_DB_PASSWORD=
APP_DB_PASSWORD=

# Mode ombre (V1.0) : rien n'est exécuté
OBSERVIA_SHADOW_MODE=true
OBSERVIA_EXECUTION_ENABLED=false

# Modèle local servi par Ollama (H1 invalidée : aucune donnée ne quitte le site)
OBSERVIA_MODEL_NAME=qwen2.5:7b-instruct
OBSERVIA_MODEL_TEMPERATURE=0
OBSERVIA_PSEUDONYMIZE=false
# Inférence CPU : plafonds à recalibrer au PoC modèle (SAD §3.6 visait 30 s)
OBSERVIA_MODEL_TIMEOUT_S=90
OBSERVIA_AGENT_MAX_SECONDS=180
OBSERVIA_AGENT_CONCURRENCY=1

# RAG : plongements Ollama + pgvector
OBSERVIA_EMBED_MODEL=nomic-embed-text
OBSERVIA_RAG_TOP_K=4
OBSERVIA_RAG_MIN_SCORE=0.35

# Jeton de service MCP (long, aléatoire)
OBSERVIA_MCP_TOKEN=

# Notification (D11) : SMS + e-mail interne obligatoires pour le niveau 3
OBSERVIA_SMTP_HOST=smtp.interne
OBSERVIA_SMTP_PORT=25
OBSERVIA_SMTP_FROM=observia@dc.interne
OBSERVIA_EMAIL_RECIPIENTS=admin-dc@dc.interne
OBSERVIA_SMS_GATEWAY_URL=
OBSERVIA_SMS_RECIPIENTS=
OBSERVIA_TEAM_WEBHOOK_URL=
OBSERVIA_CONSOLE_BASE_URL=https://observia.dc.interne

# Console : SSO OIDC (recommandé) ou secret HS256 du pilote
OBSERVIA_OIDC_JWKS_URL=
OBSERVIA_OIDC_AUDIENCE=
OBSERVIA_CONSOLE_JWT_SECRET=

# Audit (D12). Premier déploiement : journal PostgreSQL chaîné seul (profil A−).
# Pour immudb : INSTALL_IMMUDB=1, OBSERVIA_IMMUDB_ENABLED=true, puis --profile immudb.
INSTALL_IMMUDB=0
OBSERVIA_IMMUDB_ENABLED=false
OBSERVIA_IMMUDB_ADDR=immudb:3322
OBSERVIA_IMMUDB_PASSWORD=

# Collecteur : clé de la source « carte physique » (shared.admin add-source)
CARD_SOURCE_KEY=
